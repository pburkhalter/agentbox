#!/bin/bash
# Small front end for the things one does inside the container.
set -uo pipefail
# shellcheck source=../lib/agentbox/lib.sh
. /usr/local/lib/agentbox/lib.sh

services=(cloudcli claude-rc codex-rc cli-bridge)
bridge=(python3 -I /usr/local/lib/agentbox/cli-bridge/main.py)

usage() {
	cat <<-EOF
		usage: agentbox COMMAND

		  status            versions, logins and services
		  attach            attach to Claude Remote Control (detach: Ctrl-b d)
		  pair              print a Codex pairing code for the ChatGPT app
		  restart SERVICE   restart one of: ${services[*]}
		  cli-bridge status          the bridge's adapters, logins and models
		  cli-bridge login claude|codex
		                             log the bridge's own CLI copy in (separate
		                             from your interactive login)
		  cli-bridge check [MODEL…]  real calls through the running bridge:
		                             latency, and every file written meanwhile
	EOF
}

login_state() {
	if "$@" >/dev/null 2>&1; then echo "logged in"; else echo "not logged in"; fi
}

case "${1:-}" in
status)
	echo "claude   $(claude --version 2>/dev/null)  ($(login_state claude auth status))"
	echo "codex    $(codex --version 2>/dev/null)  ($(login_state codex login status))"
	echo "cloudcli $(cloudcli --version 2>/dev/null)"
	echo "gh       $(gh --version 2>/dev/null | head -1)  ($(login_state gh auth status))"
	echo
	for s in "${services[@]}"; do
		printf '%-10s %s\n' "$s" "$(s6-svstat "$AGENTBOX_SCANDIR/$s" 2>&1)"
	done
	echo
	tmux ls 2>/dev/null || echo "no tmux sessions"
	if [ "${AGENTBOX_CLI_BRIDGE:-0}" = 1 ]; then
		echo
		"${bridge[@]}" status
	fi
	;;
attach)
	exec tmux attach -t =claude
	;;
pair)
	exec codex remote-control pair
	;;
restart)
	[[ " ${services[*]} " == *" ${2:-} "* ]] || { usage; exit 2; }
	# A service that stopped itself (cli-bridge after a configuration error)
	# is brought up again; a running one is restarted.
	if [ "$(s6-svstat -o up "$AGENTBOX_SCANDIR/$2" 2>/dev/null)" = true ]; then
		exec s6-svc -r "$AGENTBOX_SCANDIR/$2"
	fi
	exec s6-svc -u "$AGENTBOX_SCANDIR/$2"
	;;
cli-bridge)
	case "${2:-}" in
	status | login | check) exec "${bridge[@]}" "${@:2}" ;;
	*)
		usage
		exit 2
		;;
	esac
	;;
*)
	usage
	[ -z "${1:-}" ] || exit 2
	;;
esac
