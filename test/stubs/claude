#!/bin/bash
# Test stand-in: reports a login, and `remote-control` waits for an answer
# like the real first run does. Everything else goes to the real CLI.
if [ "${1:-} ${2:-}" = "auth status" ]; then
	echo '{"loggedIn": true}'
	exit 0
fi
if [ "${1:-}" = remote-control ]; then
	echo "stub claude $* (cwd $PWD)"
	read -r -p "Enable Remote Control? (y/n) " answer
	echo "answer: $answer"
	exit 3
fi
exec /opt/agentbox/node_modules/.bin/claude "$@"
